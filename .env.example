# Copy to .env (docker compose reads it automatically). Never commit .env.
# --- MLflow ---
# Local default (no server): leave unset -> sqlite in ./mlflow_local. With the Docker stack use the service URL:
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_UI_URL=http://localhost:5000
# --- API ---
FLIGHTOPS_API_URL=http://localhost:8000
# Optional: require X-API-Key on /predict endpoints
FLIGHTOPS_API_KEY=
# --- Dashboard admin (approve / deploy / rollback). Leave empty to DISABLE admin controls. ---
FLIGHTOPS_ADMIN_TOKEN=salaheddine12345
# --- Dataset override (e.g. the SYNTHETIC demo file) ---
# FLIGHTOPS_DATASET=data/raw/ai4i2020_synthetic_demo.csv
LOG_LEVEL=INFO
