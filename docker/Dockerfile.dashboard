# syntax=docker/dockerfile:1
# Full image: dashboard + training worker + CLI (used by the `dashboard` and `trainer` services).
FROM python:3.12-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements.txt .
RUN pip install -r requirements.txt

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 git \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 app
COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/app/src:/app PYTHONUNBUFFERED=1 FLIGHTOPS_ROOT=/app \
    FLIGHTOPS_ARTIFACTS_DIR=/app/artifacts
WORKDIR /app
COPY --chown=app:app src ./src
COPY --chown=app:app dashboard ./dashboard
COPY --chown=app:app workers ./workers
COPY --chown=app:app configs ./configs
RUN mkdir -p /app/artifacts /app/data /app/reports && chown -R app:app /app
USER app
EXPOSE 8501
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3)"
CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true", "--browser.gatherUsageStats=false"]
